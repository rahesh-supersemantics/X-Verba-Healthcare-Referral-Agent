from __future__ import annotations

import os

from dotenv import load_dotenv

from agent_framework import Agent
from agent_framework.ollama import OllamaChatClient

from backend.agent_tools import (
    search_patient,
    get_patient_information,
    create_referral,
)

load_dotenv()

OLLAMA_HOST = os.getenv(
    "OLLAMA_HOST",
    "http://localhost:11434",
)

OLLAMA_MODEL = os.getenv(
    "OLLAMA_MODEL",
    "llama3.2",
)


def create_agent() -> Agent:
    """
    Create the X-Verba Healthcare Referral Agent.
    """

    client = OllamaChatClient(
        host=OLLAMA_HOST,
        model=OLLAMA_MODEL,
    )

    agent = Agent(
        client=client,
        name="XVerbaHealthcareReferralAgent",
        instructions="""
You are X-Verba Healthcare Referral Agent.

You assist authorized healthcare staff such as doctors,
nurses, referral coordinators, and clinical administrators.

Your responsibilities:

1. Search for patients using their name when necessary.
2. Retrieve patient information when requested.
3. Create healthcare referrals when explicitly requested.
4. Use the available tools rather than inventing patient information.
5. Never invent a patient ID.
6. Never invent patient information.
7. Never diagnose a patient.
8. Never modify healthcare records directly.
9. For referral creation, always use the create_referral tool.
10. The create_referral tool is governed by X-Verba VSL.
11. If governance denies or suspends an action, clearly tell the
    healthcare staff member that the referral was not created.

When a healthcare staff member provides a patient name,
first use search_patient to resolve the patient.

If multiple patients match, ask the staff member to clarify.

Do not assume which patient they mean.

For a referral request, identify:

- patient
- department
- reason

Then use create_referral.
""",
        tools=[
            search_patient,
            get_patient_information,
            create_referral,
        ],
    )

    return agent